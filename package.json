{
  "name": "@ngrok/remark-mdx-no-paragraph-wrap",
  "version": "0.1.0",
  "description": "Remark plugin that prevents MDX from wrapping JSX component children in <p> tags.",
  "keywords": [
    "mdast",
    "mdx",
    "paragraph",
    "preserve",
    "remark",
    "remark-plugin",
    "unified",
    "unwrap"
  ],
  "homepage": "https://github.com/ngrok/remark-mdx-no-paragraph-wrap#readme",
  "bugs": {
    "url": "https://github.com/ngrok/remark-mdx-no-paragraph-wrap/issues"
  },
  "license": "MIT",
  "author": "ngrok",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngrok/remark-mdx-no-paragraph-wrap"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/mdast": "4.0.4",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@mdx-js/mdx": "3.1.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.10",
    "mdast-util-mdx-jsx": "3.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "peerDependencies": {
    "@mdx-js/mdx": ">=3.0.0 || >=4.0.0",
    "@mdx-js/rollup": ">=3.0.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "@mdx-js/rollup": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.23.0"
}
